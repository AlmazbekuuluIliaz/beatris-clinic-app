# Виртуальные окружения (Windows-бинарники в образ Linux не нужны)
venv/
.venv/

# Python кэш
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Логи и временные файлы
*.log
_tmp_*
_uvicorn*

# Локальные секреты — пробрасываются через environment в compose
.env

# Git и IDE
.git/
.gitignore
.idea/
.vscode/

# Тесты и документация в рантайме не нужны
tests/
